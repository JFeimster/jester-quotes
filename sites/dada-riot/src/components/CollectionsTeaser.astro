---
import { collections, collectionArtworkPath } from '../lib/collections';
---
<section class="collections-teaser dada-cover-section" aria-labelledby="collections-teaser-title">
  <div class="dada-section-heading">
    <h2 id="collections-teaser-title"><span>EXPLORE</span> COLLECTIONS</h2>
    <a href="/collections/">VIEW ALL COLLECTIONS <span aria-hidden="true">↗</span></a>
  </div>
  <div class="dada-cover-grid">
    {collections.map((collection,index) => (
      <a class="dada-cover" href={`/collections/${collection.slug}/`} aria-label={`Explore ${collection.title}, ${collection.quotes.length} quotations`}>
        <img src={collectionArtworkPath(collection.slug)} alt="" width="960" height="720" loading="lazy" decoding="async"/>
        <span class="dada-cover-top">NO. {String(index+1).padStart(2,'0')} / JESTER QUOTES</span>
        <strong>{collection.title}</strong>
        <span class="dada-cover-count">{collection.quotes.length} QUOTES <span aria-hidden="true">↗</span></span>
      </a>
    ))}
  </div>
</section>
