---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mediaExamples } from '../../lib/research';
import mediaImages from '../../data/jesters-in-media-images.json';
import '../../styles/research.css';
import '../../styles/research-media-revisions.css';
import '../../styles/research-media-enriched.css';
const media = [...new Set(mediaExamples.map(item => item.medium))];
const imageById: Record<string, {src:string;source_page:string;width:number|null;height:number|null}> = mediaImages;
---
<BaseLayout title="Jesters in Media — Jester Quotes" description="Character-driven studies of comic fools, tricksters, and unruly sidekicks across film, literature, television, and comics.">
  <div class="wrap research-page">
    <p class="eyebrow">Characters / comedy / disruption</p>
    <h1>Jesters in <em>media.</em></h1>
    <p class="research-intro">Meet 24 characters who turn solemnity into trouble. The first 15 are interpreted from the supplied archetype essay; nine additional examples draw on researched character and production references. These labels are editorial interpretations, not official classifications.</p>
    <div class="media-controls">
      <label>Find a character <input id="media-query" type="search" placeholder="Search character or work" autocomplete="off" /></label>
      <label>Medium <select id="media-medium"><option value="all">All media</option>{media.map(value => <option value={value}>{value}</option>)}</select></label>
    </div>
    <p id="media-count" role="status" aria-live="polite">{mediaExamples.length} characters</p>
    <div class="research-grid media-grid-enriched" id="media-grid">
      {mediaExamples.map(item =>
        <article class="research-card media-character-card" id={item.slug} data-name={`${item.name} ${item.originating_work} ${item.tags.join(' ')}`.toLowerCase()} data-medium={item.medium}>
          {imageById[item.id]?.src ?
            <figure class="research-card-image">
              <img
                src={imageById[item.id].src}
                alt={`Illustration of ${item.character} from the source article`}
                width={imageById[item.id].width || 800}
                height={imageById[item.id].height || 500}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </figure>
            : <div class="research-card-image media-image-placeholder" aria-hidden="true"><span>THE JESTER FILES</span><strong>✳</strong></div>
          }
          <span class="research-card-type">{item.medium}</span>
          <h2>{item.character}</h2>
          <h3>{item.originating_work}</h3>
          <p>{item.summary}</p>
          {item.publication_status==='draft' && item.description !== item.summary &&
            <details class="media-character-more"><summary>Read character analysis</summary><p>{item.description}</p></details>}
        </article>
      )}
    </div>
    <p class="research-source"><strong>Source and image attribution:</strong> The first 15 entries and illustrations were adapted from <a href="https://arielhudnall.com/2015/09/06/archetypes-jester/" target="_blank" rel="external noopener noreferrer">Ariel Hudnall, <cite>Archetypes: Jester</cite></a>. Supplemental character descriptions use research from studios, film databases, and cultural archives. External images belong to their respective rightsholders; their use and availability must be verified. <a href="/sources/">Research policy and sources</a>.</p>
  </div>
  <script is:inline>
    const query = document.querySelector('#media-query');
    const medium = document.querySelector('#media-medium');
    const cards = [...document.querySelectorAll('#media-grid .research-card')];
    const count = document.querySelector('#media-count');
    function filter() {
      let visible = 0;
      for (const card of cards) {
        const show = card.dataset.name.includes(query.value.trim().toLowerCase()) &&
          (medium.value === 'all' || card.dataset.medium === medium.value);
        card.hidden = !show;
        if (show) visible++;
      }
      count.textContent = `${visible} characters`;
    }
    for (const control of [query,medium]) control.addEventListener('input',filter);
  </script>
</BaseLayout>
