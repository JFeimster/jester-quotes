---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mediaExamples } from '../../lib/research';
import mediaImages from '../../data/jesters-in-media-images.json';
import '../../styles/research.css';
import '../../styles/research-media-revisions.css';
const media = [...new Set(mediaExamples.map(item => item.medium))];
const imageById: Record<string, {
  src: string; source_page: string; source_caption: string;
  width: number | null; height: number | null;
}> = mediaImages;
---
<BaseLayout title="Jesters in Media — Jester Quotes" description="An attributed editorial directory of comic and disruptive characters in film, television, literature, and comics.">
  <div class="wrap research-page">
    <p class="eyebrow">Characters / comedy / disruption</p>
    <h1>Jesters in <em>media.</em></h1>
    <p class="research-intro">Explore 24 characters interpreted through a jester lens in the supplied essay. Fifteen have developed descriptions; nine are brief examples that need more research. These are editorial readings, not official character designations.</p>
    <div class="media-controls">
      <label>Find a character <input id="media-query" type="search" placeholder="Search character or work" autocomplete="off" /></label>
      <label>Medium <select id="media-medium"><option value="all">All media</option>{media.map(value => <option value={value}>{value}</option>)}</select></label>
    </div>
    <p id="media-count" role="status" aria-live="polite">{mediaExamples.length} examples</p>
    <div class="research-grid" id="media-grid">
      {mediaExamples.map(item =>
        <article class="research-card" id={item.slug} data-name={`${item.name} ${item.originating_work}`.toLowerCase()} data-medium={item.medium}>
          {imageById[item.id] &&
            <figure class="research-card-image">
              <img
                src={imageById[item.id].src}
                alt={`Source article illustration for ${item.character}`}
                width={imageById[item.id].width || 800}
                height={imageById[item.id].height || 500}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <figcaption><a href={imageById[item.id].source_page} target="_blank" rel="external noopener noreferrer">Image source</a></figcaption>
            </figure>}
          <span class="research-card-type">{item.medium}{item.publication_status === 'draft' ? ' · Needs research' : ''}</span>
          <h2>{item.character}</h2>
          <h3>{item.originating_work}</h3>
          <p>{item.summary}</p>
        </article>
      )}
    </div>
    <p class="research-source">Editorial source: <a href={mediaExamples[0].sources[0]} rel="external noopener">Archetypes: Jester</a>. Third-party images are loaded from the URLs supplied in the research document and are not stored in this repository. Their rights and hotlink reliability require confirmation before production use.</p>
  </div>
  <script is:inline>
    const query = document.querySelector('#media-query');
    const medium = document.querySelector('#media-medium');
    const cards = [...document.querySelectorAll('#media-grid .research-card')];
    const count = document.querySelector('#media-count');
    function filter() {
      let visible = 0;
      for (const card of cards) {
        const show = card.dataset.name.includes(query.value.trim().toLowerCase()) &&
          (medium.value === 'all' || card.dataset.medium === medium.value);
        card.hidden = !show;
        if (show) visible++;
      }
      count.textContent = `${visible} examples`;
    }
    for (const control of [query, medium]) control.addEventListener('input', filter);
  </script>
</BaseLayout>
