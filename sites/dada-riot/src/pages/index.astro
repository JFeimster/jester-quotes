---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedQuote from '../components/FeaturedQuote.astro';
import DiscoveryGateway from '../components/DiscoveryGateway.astro';
import CollectionsTeaser from '../components/CollectionsTeaser.astro';
import WatchAndLearn from '../components/WatchAndLearn.astro';
import RiotPressTeaser from '../components/RiotPressTeaser.astro';
import FavoritesPanel from '../components/FavoritesPanel.astro';
import SourceAttribution from '../components/SourceAttribution.astro';
import { quotes } from '../lib/quote-data';
import { collectionSchema } from '../lib/seo';
const structuredData = collectionSchema(Astro.site ?? new URL('https://jester-quotes.vercel.app'), quotes);
---
<BaseLayout structuredData={structuredData}>
  <div class="wrap home-discovery">
    <Hero />
    <FeaturedQuote quote={quotes[4] ?? quotes[0]} />
    <DiscoveryGateway />
    <CollectionsTeaser />
    <section class="home-studio-promo" aria-labelledby="home-studio-title">
      <div class="studio-promo-copy"><p class="eyebrow">The quote studio / artist's proof</p><h2 id="home-studio-title">Turn any quote<br/>into <em>a statement.</em></h2><p>Choose a canonical voice. Set the type. Make complete quote art, posters, and social graphics with attribution intact.</p><a class="btn" href="/studio/">Enter the printshop ↗</a><span class="studio-promo-note">100 voices / 4 formats / your words stay whole</span></div>
      <div class="studio-print-collage" aria-label="Examples of quote artwork made in the studio">
        <figure class="print-proof print-proof--one"><img src="/social/quotes/jester-quote-003.png" alt="Jester Quotes social poster preview, sample one" width="1200" height="630" loading="lazy"/><figcaption>PROOF / 01</figcaption></figure>
        <figure class="print-proof print-proof--two"><img src="/social/quotes/jester-quote-006.png" alt="Jester Quotes social poster preview, sample two" width="1200" height="630" loading="lazy"/><figcaption>PROOF / 02</figcaption></figure>
        <figure class="print-proof print-proof--three"><img src="/social/quotes/jester-quote-012.png" alt="Jester Quotes social poster preview, sample three" width="1200" height="630" loading="lazy"/><figcaption>PROOF / 03</figcaption></figure>
      </div>
    </section>
    <WatchAndLearn />
    <RiotPressTeaser />
    <section class="home-archive-callout" aria-labelledby="home-archive-title">
      <p class="eyebrow">The full court / All preserved voices</p>
      <h2 id="home-archive-title">Got a little more <em>mischief</em> in you?</h2>
      <p>The complete quote archive is waiting, with search, saved favorites, and poster-making tools.</p>
      <a class="btn" href="/quotes/">EXPLORE ALL QUOTES ↗</a>
    </section>
    <FavoritesPanel />
    <SourceAttribution />
  </div>
  <script src="../scripts/quote-explorer.ts"></script>
</BaseLayout>
