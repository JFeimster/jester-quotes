---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DadaSearchStrip from '../components/DadaSearchStrip.astro';
import FeaturedQuote from '../components/FeaturedQuote.astro';
import CollectionsTeaser from '../components/CollectionsTeaser.astro';
import DadaStudioArchive from '../components/DadaStudioArchive.astro';
import { quotes } from '../lib/quote-data';
import { collectionSchema } from '../lib/seo';
import '../styles/dada-home-fidelity.css';
const structuredData = collectionSchema(Astro.site ?? new URL('https://jester-quotes.vercel.app'), quotes);
const featured = quotes.find(q => q.id === 'jester-quote-006') ?? quotes[0];
---
<BaseLayout structuredData={structuredData}>
  <div class="wrap home-discovery reference-home">
    <Hero />
    <DadaSearchStrip />
    <FeaturedQuote quote={featured} />
    <CollectionsTeaser />
    <DadaStudioArchive />
    <p class="reference-home-source"><span>JQ / AN UNAUTHORIZED PUBLICATION</span><a href="/sources/">Sources, attribution & corrections ↗</a></p>
  </div>
  <script src="../scripts/quote-explorer.ts"></script>
</BaseLayout>
