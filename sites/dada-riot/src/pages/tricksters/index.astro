---
import '../../styles/tricksters.css';
import '../../styles/tricksters-expanded.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import registry from '../../../../../data/tricksters-139-source-registry.json';
import { tricksters as verifiedProfiles } from '../../lib/tricksters';

const verifiedSlugs = new Set(verifiedProfiles.map(profile => profile.slug));
const labels: Record<string, string> = {
  fictional_character: 'Fictional character',
  real_person: 'Real person',
  mythic_or_religious_figure: 'Myth & religion',
  folklore_figure_or_motif: 'Folklore',
  collective_or_motif: 'Group or motif',
  ambiguous_reference: 'Reference / subject'
};
const cards = registry.entries.map(entry => {
  const independentSources = entry.sources.filter(source => source.role !== 'compilation_provenance');
  const profileSlug = entry.related_verified_profile_slug && verifiedSlugs.has(entry.related_verified_profile_slug)
    ? entry.related_verified_profile_slug : null;
  const traits = entry.trickster_traits.map(trait => trait.toLowerCase().replace(/\s+/g, '-'));
  return {
    ...entry,
    independentSources,
    firstSource: independentSources[0] ?? null,
    profileSlug,
    normalizedTraits: traits,
    searchText: [
      entry.display_name, entry.source_name, entry.origin_or_work, entry.source_context,
      entry.summary, entry.subject_type, ...entry.media, ...entry.trickster_traits
    ].filter(Boolean).join(' ').toLowerCase(),
    kindLabel: labels[entry.subject_type] ?? 'Research subject'
  };
});
const categories = [...new Set(cards.map(card => card.subject_type))].sort();
const media = [...new Set(cards.flatMap(card => card.media))].sort();
const traits = [...new Set(cards.flatMap(card => card.normalizedTraits))].sort();
const photoCount = cards.filter(card => Boolean(card.image?.src)).length;
const sourcedCount = cards.filter(card => card.independentSources.length > 0).length;
const extras = verifiedProfiles.filter(profile => !cards.some(card => card.profileSlug === profile.slug));
---
<BaseLayout
  title="139 Tricksters — Characters, Mythology, Folklore & Culture | Jester Quotes"
  description="Explore 139 trickster figures across mythology, folklore, film, television and music. Search by names, origins, works, traits and media."
>
  <div class="wrap discovery-page trickster-page trickster-expanded">
    <header class="trickster-header">
      <div>
        <p class="eyebrow">Beyond the court / The expanded archive</p>
        <h1>The trickster <em>files.</em></h1>
        <p class="lede">139 possibilities. Gods, rebels, comedians, shape-shifters and fictional troublemakers. Some are established tricksters; others are interpretations worth questioning.</p>
        <div class="trickster-header-actions">
          <a class="btn" href="#trickster-directory">Explore all 139 ↗</a>
          <a class="btn secondary" href="#image-credits">Artwork &amp; sources ↗</a>
        </div>
      </div>
      <aside class="trickster-hero-aside" aria-label="Directory research notes">
        <span class="trickster-hero-symbol" aria-hidden="true">✳</span>
        <p class="eyebrow">The archive is open</p>
        <h2>Every trick has <em>a story.</em></h2>
        <p>Our index includes interpretations and research leads across many traditions. Follow dedicated stories and supporting sources for deeper context.</p>
        <a href="/sources/">Read our source policy ↗</a>
      </aside>
    </header>

    <section id="trickster-directory" aria-labelledby="trickster-directory-title">
      <div class="section-title">
        <div>
          <p class="eyebrow">The extended cast</p>
          <h2 id="trickster-directory-title">Meet the <em>rulebreakers.</em></h2>
        </div>
        <span class="byline">{cards.length} names · {photoCount} image selections · {sourcedCount} with independent reference leads</span>
      </div>
      <div class="trickster-controls" role="search" aria-label="Search Trickster directory">
        <div class="trickster-field trickster-field--search">
          <label for="trickster-search">Search names, stories and themes</label>
          <input id="trickster-search" type="search" placeholder="Try Loki, musician, mischief…" autocomplete="off" />
        </div>
        <div class="trickster-field">
          <label for="trickster-kind">Figure type</label>
          <select id="trickster-kind">
            <option value="all">All figure types</option>
            {categories.map(kind => <option value={kind}>{labels[kind] ?? kind.replaceAll('_',' ')}</option>)}
          </select>
        </div>
        <div class="trickster-field">
          <label for="trickster-medium">Where they appear</label>
          <select id="trickster-medium">
            <option value="all">All media</option>
            {media.map(item => <option value={item}>{item.replaceAll('-',' ')}</option>)}
          </select>
        </div>
        <div class="trickster-field">
          <label for="trickster-tag">Trickster trait</label>
          <select id="trickster-tag">
            <option value="all">All traits</option>
            {traits.map(trait => <option value={trait}>{trait.replaceAll('-',' ')}</option>)}
          </select>
        </div>
        <button id="trickster-reset" class="trickster-reset" type="button">Clear all</button>
      </div>
      <div id="trickster-active-filters" class="trickster-active-filters" aria-label="Active filters" hidden></div>
      <div class="trickster-results-row">
        <p id="trickster-count" aria-live="polite">{cards.length} of {cards.length} entries</p>
        <div class="trickster-view-actions">
          <button id="trickster-density" class="mini-action" type="button" aria-pressed="false">Compact view</button>
          <button id="trickster-random" class="mini-action" type="button">Random trickster ✳</button>
        </div>
      </div>
      <div id="trickster-grid" class="trickster-grid">
        {cards.map(card => (
          <article
            class="trickster-card trickster-registry-card"
            tabindex="-1"
            data-trickster-card
            data-kind={card.subject_type}
            data-medium={card.media.join(' ')}
            data-tags={card.normalizedTraits.join(' ')}
            data-search={card.searchText}
            data-summary={card.summary || 'An entry in the original trickster research compilation.'}
            data-origin={card.origin_or_work || card.source_context}
            data-name={card.display_name}
            data-kind-label={card.kindLabel}
            id={card.slug}
          >
            <div class="trickster-registry-art" class:list={{'no-image': !card.image?.src}}>
              {card.image?.src && <img src={card.image.src} alt={card.image.alt_text || card.display_name} loading="lazy" decoding="async" onerror="this.closest('.trickster-registry-art').classList.add('no-image')" />}
              <span class="trickster-registry-fallback" aria-hidden="true">✳</span>
            </div>
            <div class="trickster-card-top">
              <span>FILE / {String(card.source_list_number).padStart(3,'0')}</span>
              <button class="trickster-card-kind trickster-filter-button" type="button" data-filter="kind" data-value={card.subject_type} aria-label={`Filter figure type: ${card.kindLabel}`}>{card.kindLabel}</button>
            </div>
            <h3>{card.profileSlug ? <a href={`/tricksters/${card.profileSlug}/`}>{card.display_name}</a> : card.display_name}</h3>
            <div class="trickster-card-origin"><span>{card.origin_or_work || card.source_context}</span><div class="trickster-card-media">{card.media.map(item => <button class="trickster-filter-button" type="button" data-filter="medium" data-value={item} aria-label={`Filter medium: ${item.replaceAll('-',' ')}`}>{item.replaceAll('-',' ')}</button>)}</div></div>
            <p class="trickster-card-desc">{card.summary || 'An entry in the original trickster research compilation.'}</p>
            <div class="trickster-registry-traits">
              {card.trickster_traits.slice(0,3).map((trait, index) => <button class="trickster-filter-button" type="button" data-filter="tag" data-value={card.normalizedTraits[index]} aria-label={`Filter trait: ${trait.replaceAll('-',' ')}`}>{trait.replaceAll('-',' ')}</button>)}
            </div>
            <button class="trickster-quick-open" type="button" data-quick-open aria-label={`Quick view: ${card.display_name}`}>Quick view ↗</button>
          </article>
        ))}
      </div>
      <p id="trickster-empty" class="trickster-empty" hidden>No figures match those filters. Try clearing them.</p>
      <p id="trickster-status" role="status" class="sr-only" aria-live="polite"></p>
    </section>

    <dialog id="trickster-quick-view" class="trickster-quick-view" aria-labelledby="trickster-quick-title">
      <div class="trickster-quick-head"><span class="eyebrow">Trickster file / quick view</span><button id="trickster-quick-close" type="button" aria-label="Close quick view">Close ×</button></div>
      <div class="trickster-quick-body">
        <div id="trickster-quick-art" class="trickster-quick-art"><img id="trickster-quick-image" alt="" /><span aria-hidden="true">✳</span></div>
        <div><p id="trickster-quick-kind" class="eyebrow"></p><h2 id="trickster-quick-title"></h2><p id="trickster-quick-origin"></p><p id="trickster-quick-summary"></p><div id="trickster-quick-media" class="trickster-quick-chips"></div><div id="trickster-quick-traits" class="trickster-quick-chips"></div></div>
      </div>
    </dialog>

    <aside class="trickster-research-note">
      <span class="trickster-note-mark" aria-hidden="true">i</span>
      <div>
        <h2>Names are not endorsements.</h2>
        <p>This is a source-based editorial index of 139 suggested examples. Some names describe distinct cultural or religious traditions, and others are deliberately debatable character interpretations. Images are credited separately and copyrighted promotional imagery is used for character-specific editorial discussion, where applicable.</p>
      </div>
    </aside>

    {extras.length > 0 && <section class="trickster-extra-profiles" aria-label="More trickster stories">
      <h2>Beyond the original 139.</h2>
      <p>Explore these stories from the established archive, which weren't separate entries in the source compilation.</p>
      <div>{extras.map(profile => <a href={`/tricksters/${profile.slug}/`}>{profile.name} ↗</a>)}</div>
    </section>}

    <details class="trickster-image-credits" id="image-credits">
      <summary>Image credits, licensing &amp; source records ({photoCount})</summary>
      <p>Image attribution and rights information is linked to the file's source page. Wikipedia and other third-party fair-use claims are not transferable permissions; character-specific editorial use requires its own justification.</p>
      <ol>
        {cards.filter(card => card.image?.src).map(card => <li>
          <strong>{card.display_name}</strong>
          <span>{card.image?.attribution || card.image?.creator || 'Original source credited'}</span>
          {card.image?.source_url && <a href={card.image.source_url} target="_blank" rel="noopener noreferrer">Source and license ↗</a>}
        </li>)}
      </ol>
    </details>
  </div>
  <script src="../../scripts/trickster-explorer.ts"></script>
</BaseLayout>
