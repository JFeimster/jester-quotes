{
  "name": "jester-quotes-dada-riot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run social:generate && astro build",
    "preview": "astro preview",
    "check": "node scripts/validate-dada-assets.mjs && astro check",
    "test": "npm run build && node --test tests/dada-site.test.mjs tests/quote-data.test.mjs tests/interaction-logic.test.mjs tests/daily-saved.test.mjs tests/discovery-studio.test.mjs tests/social-images.test.mjs tests/site-integrity.test.mjs",
    "social:generate": "node scripts/generate-social-images.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:inventory": "node scripts/inventory-assets.mjs"
  },
  "dependencies": {
    "astro": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0"
  }
}
