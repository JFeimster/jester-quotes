---
import QuoteCard from '../../components/QuoteCard.astro';
import {getTheme,labThemeStyle} from '../theme-registry';
import type {Quote} from '../../types/quote';
const {samples}=Astro.props as {samples:[Quote,Quote,Quote]};
const theme=getTheme('neo-brutalist');
---
<section class="lab-composition lab-composition--brutalist" data-theme="neo-brutalist" style={labThemeStyle(theme)} aria-label="Neo-Brutalist Jester layout preview">
  <div class="lab-brutalist-topline"><span>THE JESTER / INDEPENDENT PRESS</span><span>VOL. 002 — CHAOS DEPT.</span></div>
  <div class="lab-brutalist-hero">
    <div class="lab-brutalist-headline"><span class="lab-brutalist-tag">DISOBEY / THINK / LAUGH</span>
      <h2>NO KING.<br/><i>NO CLOWN.</i><br/>JUST TRUTH.</h2>
      <p>All caps. Sharp elbows. No royal permission required.</p></div>
    <div class="lab-brutalist-symbol" aria-hidden="true"><span>✳</span><strong>JESTER!</strong><small>LICENSED TO INTERRUPT</small></div>
  </div>
  <div class="lab-brutalist-actions"><a href="/collections/truth-to-power/">TRUTH TO POWER ↗</a><a href="/studio/">MAKE SOME ART ↗</a><a href="/videos/">WATCH THE CHAOS ↗</a></div>
  <div class="lab-brutalist-divider"><span>ISSUE 002 / NO SILENT CONSENT</span><span>↓ SCROLL THE EVIDENCE ↓</span></div>
  <div class="lab-quote-grid lab-quote-grid--brutalist">
    <QuoteCard quote={samples[0]} index={0}/><QuoteCard quote={samples[1]} index={3}/><QuoteCard quote={samples[2]} index={5}/>
  </div>
  <div class="lab-brutalist-footer">NOTHING IS SACRED. EXCEPT THE SOURCES. <a href="/sources/">SHOW RECEIPTS ↗</a></div>
</section>
