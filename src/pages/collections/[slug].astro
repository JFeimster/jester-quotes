---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import QuoteSearch from '../../components/QuoteSearch.astro';
import { collections } from '../../lib/collections';
import { quotes } from '../../lib/quote-data';
import type { CuratedCollection } from '../../lib/collections';

export function getStaticPaths() {
  return collections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}
const { collection } = Astro.props as { collection: CuratedCollection };
const indices = new Map(quotes.map((quote, index) => [quote.id, index]));
---
<BaseLayout title={`${collection.title} — Curated Jester Quotes`} description={collection.description}>
  <div class="wrap discovery-page">
    <header class="discovery-heading collection-heading">
      <a href="/collections/" class="back-link">← All collections</a>
      <p class="eyebrow">{collection.eyebrow} · {collection.quotes.length} quotes</p>
      <h1>{collection.title}<span class="heading-dot" aria-hidden="true">.</span></h1>
      <p class="lede">{collection.description}</p>
      <div class="discovery-actions"><a class="btn" href={`/studio/?quote=${collection.quotes[0]?.id}`}>Create artwork from this collection ↗</a><a class="btn secondary" href="/sources/">Source notes ↗</a></div>
    </header>
    <section id="explore" aria-label={`Quotes in ${collection.title}`}>
      <div class="section-title">
        <div><p class="eyebrow">From the collection</p><h2>Selected voices.</h2></div>
        <span class="byline">{collection.quotes.length} curated entries</span>
      </div>
      <QuoteSearch />
      <p id="result-count" class="result-count" aria-live="polite">{collection.quotes.length} quotes</p>
      <p class="sr-only" id="interaction-status" role="status" aria-live="polite"></p>
      <div class="gallery" id="quote-gallery">
        {collection.quotes.map((quote) => <QuoteCard quote={quote} index={indices.get(quote.id) ?? 0} />)}
      </div>
      <p id="empty-state" hidden>No quotes match those filters.</p>
    </section>
    <p class="curation-note">Curated grouping, not a claim about the original author's intent. <a href="/#explore">Browse every quote</a>.</p>
  </div>
  <script src="../../scripts/quote-explorer.ts"></script>
</BaseLayout>
