---
import type { Quote } from '../types/quote';
const { quote } = Astro.props as { quote: Quote };
---
<div class="actions">
  <button class="btn copy-quote" type="button" data-quote-text={`${quote.quote}\n— ${quote.person}`}>Copy quote</button>
  <button class="btn secondary favorite-toggle" type="button" data-quote-id={quote.id} data-person={quote.person} data-unsaved-label="♡ Save favorite" data-saved-label="♥ Saved favorite" aria-pressed="false" aria-label={`Save quote by ${quote.person} to favorites`}>♡ Save favorite</button>
  <button class="btn secondary share-quote" type="button">Share link</button>
</div>
<p class="sr-only" id="interaction-status" role="status" aria-live="polite"></p>
