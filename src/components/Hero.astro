---
import art from '../assets/jester-hero.svg';
---
<section class="hero">
  <div>
    <p class="eyebrow">A treasury of wit & mischief</p>
    <h1>Long live<br /><em>the fool.</em></h1>
    <p class="lede">One hundred irreverent reflections on humor, rebellion, and the strangely wise art of playing the jester.</p>
    <div class="hero-actions">
      <a class="btn" href="#explore">Explore all 100 quotes ↘</a>
      <button class="btn secondary" id="surprise-me" type="button">Surprise me ✧</button>
    </div>
  </div>
  <img class="hero-art" src={art.src} alt="Illustration of a theatrical jester in gold and coral" width="880" height="740" />
</section>
