---
import { resolveAssetPath } from '../lib/assets';
const heroWebp = resolveAssetPath('site-hero-portrait-webp');
---
<section class="hero hero-2" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow hero-eyebrow"><span class="hero-tiny-sigil" aria-hidden="true">✦</span> The midnight carnival / volume 001</p>
    <h1 id="hero-title"><span>Long live</span><em>the fool<span class="hero-period">.</span></em></h1>
    <p class="lede">A hundred voices. Six curious collections. One inconvenient truth: sometimes the joker is the only one telling the truth.</p>
    <div class="hero-actions">
      <a class="btn" href="#explore">Explore 100 quotes <span aria-hidden="true">↗</span></a>
      <button class="btn secondary" id="surprise-me" type="button">Surprise me <span aria-hidden="true">✳</span></button>
    </div>
    <div class="hero-utility" aria-label="Discover the site">
      <a href="/collections/"><span class="utility-index">01 / DISCOVER</span><strong>Six sides of mischief</strong><span aria-hidden="true">↗</span></a>
      <a href="/studio/"><span class="utility-index">02 / CREATE</span><strong>Make a quote your own</strong><span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <figure class="hero-visual hero-visual-2">
    <div class="hero-frame hero-frame-2">
      <picture>{heroWebp && <source srcset={heroWebp} type="image/webp" />}<img class="hero-art" src="/assets/images/heroes/midnight-carnival-hero-4x5.png" alt="Midnight Carnival jester artwork in a richly theatrical, editorial style" width="1122" height="1402" fetchpriority="high" decoding="async" /></picture>
    </div>
    <figcaption class="hero-art-caption"><span>Fig. 001 — The Fool</span><span>Wisdom wears a mask</span></figcaption>
    <div class="hero-stamp" aria-hidden="true"><span>THE</span><strong>JOKER</strong><span>IS WILD</span></div>
  </figure>
</section>
