---
import { quotes } from '../lib/quote-data';
import { studioFormats, studioThemes } from '../lib/studio-config';
---
<section class="studio-grid" aria-label="Quote artwork studio">
  <div class="studio-workbench">
    <p class="eyebrow">01 / Choose your words</p>
    <h2>The design desk.</h2>
    <p class="studio-intro">Choose a quotation, pick a palette and canvas format, then export a full-resolution PNG. No account or uploads.</p>

    <div class="studio-field">
      <label for="studio-search">Search the 100 quotations</label>
      <input id="studio-search" type="search" autocomplete="off" placeholder="Search quote text or author…" />
      <span class="studio-helper" id="studio-result-count">100 quotes available</span>
    </div>
    <div class="studio-field">
      <label for="studio-quote">Quotation</label>
      <select id="studio-quote">
        {quotes.map((quote,index) => <option value={quote.id} selected={quote.id === 'jester-quote-003'}>#{String(index+1).padStart(3,'0')} · {quote.person} · {quote.quote.replace(/\s+/g,' ').slice(0,80)}</option>)}
      </select>
      <a id="studio-source" class="studio-source-link" href="/quotes/jester-quote-003/">View full quotation and attribution ↗</a>
    </div>

    <div class="studio-field-row">
      <div class="studio-field">
        <label for="studio-format">Canvas format</label>
        <select id="studio-format">
          {Object.entries(studioFormats).map(([key,value]) => <option value={key}>{value.label}</option>)}
        </select>
      </div>
      <div class="studio-field">
        <label for="studio-theme">Color palette</label>
        <select id="studio-theme">
          {Object.entries(studioThemes).map(([key,value]) => <option value={key}>{value.label}</option>)}
        </select>
      </div>
    </div>

    <label class="studio-check"><input type="checkbox" id="studio-border" checked /> Include decorative frame</label>

    <div class="studio-action-row">
      <button type="button" class="btn secondary" id="studio-random">Surprise me ✧</button>
      <button type="button" class="btn" id="studio-download">Download PNG ↓</button>
    </div>
    <p id="studio-status" class="studio-status" role="status" aria-live="polite">Ready to render artwork.</p>
    <p class="studio-fineprint">The original quotation, supplied attribution and reference remain unchanged in the registry. Posters are generated locally in your browser; no design data is sent to a server. <a href="/sources/">Source information</a>.</p>
  </div>
  <div class="studio-stage">
    <div class="studio-stage-heading"><span>02 / Live preview</span><span id="studio-dimensions">1080 × 1080 pixels</span></div>
    <div class="studio-canvas-frame"><canvas id="studio-canvas" width="1080" height="1080" role="img" aria-label="Preview of the selected quote artwork"></canvas></div>
    <p class="studio-stage-caption">What you see is the artwork exported as PNG, at the selected full resolution.</p>
  </div>
</section>
<script src="../scripts/studio.ts"></script>
