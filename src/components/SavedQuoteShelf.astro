---
import { quotes } from '../lib/quote-data';
import QuoteCard from './QuoteCard.astro';
import { studioFormats, studioThemes } from '../lib/studio-config';
---
<section aria-label="Saved quotations" class="saved-shelf">
  <div class="saved-toolbar">
    <div class="saved-field saved-search">
      <label for="saved-search">Search your saved lines</label>
      <input id="saved-search" type="search" placeholder="Text, author or reference…" autocomplete="off" />
    </div>
    <div class="saved-field">
      <label for="saved-sort">Sort by</label>
      <select id="saved-sort">
        <option value="recent">Recently saved</option>
        <option value="original">Original archive order</option>
        <option value="author">Author A–Z</option>
      </select>
    </div>
  </div>
  <div class="saved-management" aria-label="Your favorites data">
    <button id="saved-export" type="button" class="btn secondary">Export JSON ↓</button>
    <label class="btn secondary saved-import-label" for="saved-import-file">Import JSON ↑</label>
    <input id="saved-import-file" type="file" accept=".json,application/json" aria-label="Import a saved quotes JSON file" />
    <button id="saved-clear" type="button" class="btn secondary">Clear saved quotes</button>
  </div>
  <p class="utility-status" id="saved-status" role="status" aria-live="polite">Loading saved quotes from this browser…</p>
  <div class="saved-pack-controls" aria-label="Download selected quote artwork">
    <div>
      <p class="eyebrow">Selected artwork / Offline pack</p>
      <h2>Take the <em>good stuff.</em></h2>
      <p>Pick up to 5 saved quotes using the checkboxes on their cards. All original words and author credits are preserved, including slides for longer quotations.</p>
    </div>
    <div class="saved-pack-fields">
      <div class="saved-field">
        <label for="saved-pack-format">Canvas</label>
        <select id="saved-pack-format">{(['square','portrait','story','landscape'] as const).map(key=><option value={key}>{studioFormats[key].label}</option>)}</select>
      </div>
      <div class="saved-field">
        <label for="saved-pack-theme">Palette</label>
        <select id="saved-pack-theme">{Object.entries(studioThemes).map(([id,theme])=><option value={id}>{theme.label}</option>)}</select>
      </div>
      <button type="button" id="saved-pack-download" class="btn" disabled>Download selected ZIP · 0 / 5</button>
    </div>
  </div>
  <p id="saved-count" class="result-count" aria-live="polite">0 saved quotes</p>
  <div class="gallery saved-gallery" id="saved-gallery">
    {quotes.map((quote,index)=><div class="saved-card-holder" data-saved-id={quote.id} hidden><QuoteCard quote={quote} index={index} selectable={true}/></div>)}
  </div>
  <div id="saved-empty" class="saved-empty">
    <h2>No saved quotes yet.</h2>
    <p>Find a line worth keeping, select Save, and come back here. Everything stays in this browser.</p>
    <a href="/quotes/#explore" class="btn">Explore all 100 quotes ↗</a>
  </div>
  <p class="saved-rights-note">Artwork packs include a text attribution/rights file. Third-party quotation rights are not granted by downloading. <a href="/sources/">Review the source policy</a>.</p>
</section>
