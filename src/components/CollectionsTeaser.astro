---
import { collections } from '../lib/collections';
import CollectionCard from './CollectionCard.astro';
---
<section class="collections-teaser" aria-labelledby="collections-teaser-title">
  <div class="section-title">
    <div><p class="eyebrow">Thematic galleries</p><h2 id="collections-teaser-title">Pick your mischief.</h2></div>
    <a class="section-text-link" href="/collections/">View all six collections ↗</a>
  </div>
  <p class="gallery-intro">Curated pathways through the same 100 quotations—from wise fools to spectacular absurdity.</p>
  <div class="collection-grid collection-grid--teaser">
    {collections.slice(0, 3).map((collection, index) => <CollectionCard collection={collection} index={index} />)}
  </div>
</section>
