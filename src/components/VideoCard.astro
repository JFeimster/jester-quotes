---
import type { VideoEntry } from '../types/resource';
import { tricksters, tricksterUrl } from '../lib/tricksters';
interface Props { entry: VideoEntry; index: number; }
const { entry, index } = Astro.props;
const related = entry.related_trickster_ids
  .map(id=>tricksters.find(record=>record.id===id))
  .filter((item):item is (typeof tricksters)[number]=>Boolean(item));
---
<article class:list={['vault-card','video-card',{'vault-card--featured':entry.featured}]} data-catalog-card
  data-search={`${entry.title} ${entry.summary} ${entry.channel_title} ${entry.tags.join(' ')}`.toLowerCase()}
  data-channel={entry.channel_title} data-tags={entry.tags.join(' ')}>
  <div class="vault-card-top"><span class="vault-item-number">SCREENING / {String(index+1).padStart(2,'0')}</span><span class="vault-kind">{entry.channel_title}</span></div>
  <div class="video-stage" data-video-stage>
    <div class="video-stage-poster" aria-hidden="true"><span>▶</span><small>SELECT TO LOAD PLAYER</small></div>
    <button class="video-load" type="button" data-video-id={entry.video_id} data-video-title={entry.title}
      aria-label={`Load YouTube player for ${entry.title}`}>
      <span>Load player</span><small>YouTube only after click</small>
    </button>
  </div>
  <h3>{entry.title}</h3>
  <p class="vault-source">{entry.channel_title}</p>
  <p class="vault-summary">{entry.summary}</p>
  {related.length>0 && <div class="vault-related"><span>EXPLORE RELATED PROFILES</span>
    {related.map(record=><a href={tricksterUrl(record)}>{record.name}</a>)}
  </div>}
  <div class="vault-card-foot">
    <span>Checked {entry.verified_at}</span>
    <a href={entry.youtube_url} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${entry.title} on YouTube in a new tab`}>Watch on YouTube ↗</a>
  </div>
</article>
