---
import { resolveAssetPath } from '../lib/assets';
const brandLogo = resolveAssetPath('brand-logo-horizontal');
const brandLogoWebp = resolveAssetPath('brand-logo-horizontal-webp');
---
<header class="wrap site-header site-header-2">
  <div class="topbar">
    <a class="brand" href="/" aria-label="Jester Quotes — Home">
      {brandLogo ? <picture>{brandLogoWebp && <source srcset={brandLogoWebp} type="image/webp" />}<img class="brand-logo" src={brandLogo} alt="Jester Quotes" width="150" height="84" /></picture> : <span class="brand-lockup"><strong>JESTER<span class="brand-dot">.</span></strong><small>Quotes / The Carnival</small></span>}
    </a>
    <nav aria-label="Main navigation">
      <a href="/#explore">Explore</a>
      <a href="/daily/">Daily</a>
      <a href="/collections/">Collections</a>
      <a href="/tricksters/">Tricksters</a>
      <a href="/resources/">Resources</a>
      <a href="/videos/">Videos</a>
      <a href="/saved/">Saved</a>
      <a href="/about/">The Archetype</a>
      <a class="nav-studio-cta" href="/studio/">Open Quote Studio <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
