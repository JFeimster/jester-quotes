<div class="search-panel">
  <div class="search-panel-heading"><span>✧ Search the court</span><span>Find your favorite mischief</span></div>
  <div class="controls">
    <label for="quote-search" class="sr-only">Search quotes</label>
    <input id="quote-search" type="search" placeholder="Search quotes, authors, and references…" autocomplete="off" />
    <label for="reference-filter" class="sr-only">Filter references</label>
    <select id="reference-filter">
      <option value="all">All references</option>
      <option value="yes">With reference</option>
      <option value="no">Without reference</option>
    </select>
    <label class="favorites-filter-label"><input id="favorites-filter" type="checkbox" /> Favorites only</label>
    <button class="clear-filters" id="clear-filters" type="button">Clear filters</button>
  </div>
</div>
