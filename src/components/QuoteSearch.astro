<div class="controls">
  <label for="quote-search" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">Search quotes</label>
  <input id="quote-search" type="search" placeholder="Search by quote, person, or reference..." autocomplete="off"/>
  <label for="reference-filter" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">Filter references</label>
  <select id="reference-filter"><option value="all">All references</option><option value="yes">With reference</option><option value="no">Without reference</option></select>
  <label><input id="favorites-filter" type="checkbox" /> Favorites only</label>
</div>
