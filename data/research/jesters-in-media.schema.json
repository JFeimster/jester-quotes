{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jester-quotes.vercel.app/schema/jesters-in-media.schema.json",
  "title": "Jesters in Media Source Registry",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "items",
    "editorial_notes",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_id": {
      "const": "jester-quotes-jesters-in-media"
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "canonical_source_document": {
      "type": "string"
    },
    "canonical_source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "editorial_policy": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "recommended_properties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "character",
          "originating_work",
          "medium",
          "card_description",
          "description",
          "description_origin",
          "research_sources",
          "research_status",
          "publication_status",
          "image"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "character": {
            "type": "string",
            "minLength": 1
          },
          "originating_work": {
            "type": "string",
            "minLength": 1
          },
          "medium": {
            "type": "string",
            "enum": [
              "Film",
              "Comics",
              "Literature",
              "Television"
            ]
          },
          "performer": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_source_heading": {
            "type": "string"
          },
          "source_document": {
            "type": "string"
          },
          "source_article_url": {
            "type": "string",
            "format": "uri"
          },
          "archetype_traits": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "card_description": {
            "type": "string",
            "minLength": 50
          },
          "description": {
            "type": "string"
          },
          "source_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "description_origin": {
            "type": "string",
            "enum": [
              "provided_markdown",
              "new_editorial_research"
            ]
          },
          "description_complete": {
            "type": "boolean"
          },
          "research_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "publisher",
                "title",
                "url",
                "use"
              ],
              "properties": {
                "publisher": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "use": {
                  "type": "string"
                }
              }
            }
          },
          "research_status": {
            "type": "string"
          },
          "publication_status": {
            "type": "string",
            "enum": [
              "published",
              "draft"
            ]
          },
          "visual_status": {
            "type": "string"
          },
          "image": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "url",
              "source_page",
              "alt",
              "is_confirmed_reusable",
              "status"
            ],
            "properties": {
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "full_size_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "source_page": {
                "type": "string",
                "format": "uri"
              },
              "alt": {
                "type": "string"
              },
              "width": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "is_confirmed_reusable": {
                "type": "boolean"
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "editorial_note": {
                "type": "string"
              }
            }
          },
          "editorial_note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "editorial_notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
